#include <cstdio>
#include <cstdlib>
#include <ctime>
#include <acl/acl.h>
#define CHECK(x) do{ auto r=(x); if(r!=0){printf(\"FAIL %s rc=%d\n\", #x, (int)r); return 1;} }while(0)
static double now_us(){ struct timespec t; clock_gettime(CLOCK_MONOTONIC,&t); return t.tv_sec*1e6+t.tv_nsec/1e3; }
int main(int argc,char**argv){
  size_t MB = argc>1? atoi(argv[1]) : 64;
  size_t sz = MB*1024*1024;
  CHECK(aclInit(nullptr));
  CHECK(aclrtSetDevice(0));
  void *h=nullptr,*d=nullptr;
  CHECK(aclrtMallocHost(&h,sz));
  CHECK(aclrtMalloc(&d,sz,ACL_MEM_MALLOC_HUGE_FIRST));
  memset(h,1,sz);
  // warmup
  aclrtMemcpy(d,sz,h,sz,ACL_MEMCPY_HOST_TO_DEVICE);
  const int N=10; double t0=now_us();
  for(int i=0;i<N;i++) aclrtMemcpy(d,sz,h,sz,ACL_MEMCPY_HOST_TO_DEVICE);
  double t1=now_us();
  double h2d = (double)sz*N/((t1-t0))*1e6/1e9;
  t0=now_us();
  for(int i=0;i<N;i++) aclrtMemcpy(h,sz,d,sz,ACL_MEMCPY_DEVICE_TO_HOST);
  t1=now_us();
  double d2h = (double)sz*N/((t1-t0))*1e6/1e9;
  printf(\"size=%zuMB  H2D=%.1f GB/s  D2H=%.1f GB/s\n\", MB, h2d, d2h);
  aclrtFree(d); aclrtFreeHost(h); aclrtResetDevice(0); aclFinalize();
  return 0;
}
EOF
