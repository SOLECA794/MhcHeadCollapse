BK="/d/Desktop/OP-Learning/.rivet/scratch/submodule-update-backup/lh/moved"
cd "$R"
while IFS= read -r f; do
  [ -e "$f" ] || continue
  mkdir -p "$BK/$(dirname "$f")"
