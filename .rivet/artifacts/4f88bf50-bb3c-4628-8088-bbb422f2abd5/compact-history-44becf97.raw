脚本内容：
```bash
#!/usr/bin/env bash
# 阶段1: 分析 cann-learing-hub 的 pull 障碍（纯查询 + 备份，不做破坏性操作）
set -u
export MSYS_NO_PATHCONV=1
R="/d/Desktop/OP-Learning/Ascend/cann-learing-hub"
BK="/d/Desktop/OP-Learning/.rivet/scratch/submodule-update-backup/lh"
cd "$R" || exit 1

echo "=== A. 上游新增的文件（可能与我们未跟踪文件冲突） ==="
git diff --name-only --diff-filter=A HEAD origin/master | sort > /tmp/up_added.txt
echo "上游新增: $(wc -l < /tmp/up_added.txt)"

echo "=== B. 展开未跟踪文件 ==="
: > /tmp/untracked_files.txt
git ls-files --others --exclude-standard | while IFS= read -r p; do
  if [ -d "$p" ]; then find "$p" -type f >> /tmp/untracked_files.txt 2>/dev/null
  elif [ -f "$p" ]; then echo "$p" >> /tmp/untracked_files.txt; fi
done
sort -u /tmp/untracked_files.txt -o /tmp/untracked_files.txt
echo "未跟踪文件: $(wc -l < /tmp/untracked_files.txt)"

echo "=== C. 交集 = 会被 pull 覆盖的 ==="
LC_ALL=C sort /tmp/up_added.txt -o /tmp/up_added.txt
LC_ALL=C sort /tmp/untracked_files.txt -o /tmp/untracked_files.txt
LC_ALL=C comm -12 /tmp/untracked_files.txt /tmp/up_added.txt > /tmp/conflicts.txt
echo "冲突文件: $(wc -l < /tmp/conflicts.txt)"
cat /tmp/conflicts.txt | head -10

echo "=== D. 逐一验证内容是否等于上游 ==="
SAME=0; DIFF=0; DIFFL=""
while IFS= read -r f; do
  [ -f "$f" ] || continue
  U=$(git rev-parse "origin/master:$f" 2>/dev/null) || continue
  W=$(git hash-object -- "$f" 2>/dev/null)
  if [ "$U" = "$W" ]; then SAME=$((SAME+1)); else DIFF=$((DIFF+1)); DIFFL="$DIFFL\n  $f"; fi
done < /tmp/conflicts.txt
echo "内容==上游: $SAME"
echo "内容!=上游: $DIFF"
[ -n "$DIFFL" ] && printf "差异文件:$DIFFL\n"
echo "=== 完成 ==="
```

