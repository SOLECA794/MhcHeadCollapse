[tool_call write_file] {"content":"#!/usr/bin/env bash\n# 精确列出两个仓库中「会被删除+重克隆丢失」的真实本地内容\nexport MSYS_NO_PATHCONV=1\nBASE=\"/d/Desktop/OP-Learning\"\nBK=\"$BASE/.rivet/scratch/submodule-update-backup\"\n\nfor R in \"Ascend/cannbot-skills\" \"Ascend/cann-learing-hub\"; do\n  cd \"$BASE/$R\" || continue\n  NAME=$(basename \"$R\")\n  echo \"########## $NAME ##########\"\n  echo \"  HEAD=$(git rev-parse --short HEAD)  落后上游=$(git rev-list --count HEAD..origin/master)\"\n  echo \"  体积: $(du -sh . 2>/dev/null | cut -f1)\"\n\n  echo \"  --- 已跟踪的本地改动(内容 != HEAD) ---\"\n  git diff --numstat HEAD 2>/dev/null | awk '{printf \"    %s +%s -%s\\n\",$3,$1,$2}'\n\n  echo \"  --- 其中: 内容是否等于上游某个历史版本(=可丢弃/过期) ---\"\n  git diff --name-only HEAD 2>/dev/null | while IFS= read -r f; do\n    LB=$(git hash-object -- \"$f\" 2>/dev/null)\n    HIT=\"\"\n    for c in $(git log origin/master --format=%H -- \"$f\" 2>/dev/null | head -60); do\n      [ \"$(git rev-parse \"$c:$f\" 2>/dev/null)\" = \"$LB\" ] && { HIT=\"$c\"; break; }\n    done\n    if [ -n \"$HIT\" ]; then\n      echo \"      过期上游内容 : $f  (=提交 $(git log -1 --format=%h \"$HIT\"))\"\n    else\n      echo \"      ★真实本地工作★ : $f\"\n    fi\n  done\n\n  echo \"  --- 未跟踪文件数 ---\"\n  git ls-files --others --exclude-standard 2>/dev/null | wc -l\n  echo \"\"\ndone\n","file_path":"d:\\Desktop\\OP-Learning\\.rivet\\scratch\\what-would-be-lost.sh"}
