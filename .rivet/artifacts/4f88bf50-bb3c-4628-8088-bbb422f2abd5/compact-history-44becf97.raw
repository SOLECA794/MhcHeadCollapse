[tool_call write_file] {"content":"#!/usr/bin/env bash\n# 分析未跟踪文件: 哪些是上游已有的(可安全让 pull 重建), 哪些是纯本地新文件(必须保留)\n# 用名字列表比对, 避免逐文件调用 git 造成超时\nset -u\nexport MSYS_NO_PATHCONV=1\nREPO=\"$1\"\ncd \"$REPO\" || exit 1\necho \"### 仓库: $REPO\"\n\ngit ls-files --others --exclude-standard > /tmp/untracked.txt 2>/dev/null\ngit ls-tree -r --name-only origin/master > /tmp/upstream_all.txt 2>/dev/null\n# 目录形式的未跟踪条目展开为文件\n: > /tmp/untracked_files.txt\nwhile IFS= read -r p; do\n  if [ -d \"$p\" ]; then find \"$p\" -type f -print0 2>/dev/null | tr '\\0' '\\n' >> /tmp/untracked_files.txt\n  elif [ -f \"$p\" ]; then echo \"$p\" >> /tmp/untracked_files.txt; fi\ndone < /tmp/untracked.txt\nsort -u /tmp/untracked_files.txt -o /tmp/untracked_files.txt\necho \"未跟踪文件总数: $(wc -l < /tmp/untracked_files.txt)\"\necho \"上游文件总数: $(wc -l < /tmp/upstream_all.txt)\"\n\ncomm -12 /tmp/untracked_files.txt /tmp/upstream_all.txt > /tmp/both.txt\ncomm -23 /tmp/untracked_files.txt /tmp/upstream_all.txt > /tmp/local_only.txt\necho \"--- 上游也有(会让 pull 报冲突): $(wc -l < /tmp/both.txt) ---\"\necho \"--- 纯本地独有(必须保留): $(wc -l < /tmp/local_only.txt) ---\"\nif [ -s /tmp/local_only.txt ]; then echo \"本地独有清单(前40):\"; head -40 /tmp/local_only.txt; else echo \"本地独有: 无\"; fi\n","file_path":"d:\\Desktop\\OP-Learning\\.rivet\\scratch\\analyze-untracked.sh"}
