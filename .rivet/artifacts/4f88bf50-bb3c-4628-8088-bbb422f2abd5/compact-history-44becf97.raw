好，用脚本：
```bash
cd cann-learing-hub
cnt_same=0; cnt_diff=0
git status --short | sed 's/^...//' > /tmp/lf.txt
while IFS= read -r f; do
  f=$(echo "$f" | sed 's/^"//;s/"$//')
  if git cat-file -e "origin/master:$f" 2>/dev/null; then
    if git diff --quiet origin/master -- "$f" 2>/dev/null; then
      cnt_same=$((cnt_same+1))
    else
      cnt_diff=$((cnt_diff+1))
      echo "DIFF: $f"
    fi
  else
    echo "NOT-UPSTREAM: $f"
  fi
done < /tmp/lf.txt
echo "SAME=$cnt_same DIFF=$cnt_diff"
```

