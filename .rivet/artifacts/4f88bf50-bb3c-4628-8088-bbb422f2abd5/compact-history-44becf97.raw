太绕。用 find 展开：

```bash
: > /tmp/untracked_files.txt
git ls-files --others --exclude-standard | while IFS= read -r p; do
  if [ -d "$p" ]; then find "$p" -type f >> /tmp/untracked_files.txt
  elif [ -f "$p" ]; then echo "$p" >> /tmp/untracked_files.txt
  fi
done
sort -u /tmp/untracked_files.txt -o /tmp/untracked_files.txt
comm -12 /tmp/untracked_files.txt /tmp/up_added.txt > /tmp/conflicts.txt
```

