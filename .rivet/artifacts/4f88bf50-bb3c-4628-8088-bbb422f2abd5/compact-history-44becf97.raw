[tool_call write_file] {"content":"#!/usr/bin/env bash\n# 一次性探针：验证 git submodule add 对「已存在、自带 .git、且领先/落后 remote」的目录的行为\n# 目的：确认真实仓库上执行该命令是否安全（是否重新克隆 / 是否丢本地提交）\nset -u\nSIM=\"/tmp/subsim-$$\"\nrm -rf \"$SIM\"; mkdir -p \"$SIM\"\nG=\"git -c user.email=t@t -c user.name=t\"\n\necho \"### git: $(git --version)\"\n\n# 1) 造一个 bare 远程，带 2 个提交\n$G init -q --bare -b master \"$SIM/remote.git\"\n$G clone -q \"$SIM/remote.git\" \"$SIM/seed\"\ncd \"$SIM/seed\" || exit 1\necho one > f.txt && $G add f.txt && $G commit -qm c1\necho two >> f.txt && $G add f.txt && $G commit -qm c2\n$G push -q origin master\nREMOTE_HEAD=$($G -C \"$SIM/seed\" rev-parse HEAD)\n\n# 2) 造父仓库\n$G init -q -b main \"$SIM/parent\"\ncd \"$SIM/parent\" || exit 1\necho p > p.txt && $G add p.txt && $G commit -qm parent-init\n\n# 3) 模拟现状：目录已存在、自带 .git、origin 已指向 remote、且落后 1 个提交\nmkdir -p Metax\n$G clone -q \"$SIM/remote.git\" Metax/Transformer-on-Metax\ncd Metax/Transformer-on-Metax || exit 1\n$G reset -q --hard HEAD~1          # 回退到 c1，模拟「落后」\necho localwork > local.txt && $G add local.txt && $G commit -qm \"local-only commit\"\necho \"本地独有提交: $($G rev-parse HEAD)\"\nBEFORE=$($G rev-parse HEAD)\n\ncd \"$SIM/parent\" || exit 1\necho \"--- submodule add 前：.git 是目录还是文件 ---\"\nif [ -d Metax/Transformer-on-Metax/.git ]; then echo \"DIRECTORY (独立仓库)\"; else echo \"FILE (已是子模块)\"; fi\n\necho \"--- 执行 git submodule add <url> <path> ---\"\n$G submodule add \"$SIM/remote.git\" Metax/Transformer-on-Metax 2>&1; echo \"[exit=$?]\"\n\necho \"--- 之后：.git 形态 ---\"\nif [ -d Metax/Transformer-on-Metax/.git ]; then echo \"DIRECTORY\"; else echo \"FILE (已转为子模块)\"; fi\n\ncd Metax/Transformer-on-Metax || exit 1\nAFTER=$($G rev-parse HEAD)\necho \"本地独有提交是否保留: before=$BEFORE after=$AFTER\"\nif [ \"$BEFORE\" = \"$AFTER\" ]; then echo \">>> 保留 ✓\"; else echo \">>> 丢失/被替换 ✗\"; fi\n\ncd \"$SIM/parent\" || exit 1\necho \"--- .gitmodules ---\"; cat .gitmodules\necho \"--- git ls-files -s (gitlink?) ---\"; $G ls-files -s -- Metax/Transformer-on-Metax\necho \"--- submodule 磁盘占用(是否重新克隆) ---\"; ls -a Metax/Transformer-on-Metax\necho \"### SIM=$SIM (可 read_file 复核)\"\n","file_path":"d:\\Desktop\\OP-Learning\\.rivet\\scratch\\probe-submodule-register.sh"}
