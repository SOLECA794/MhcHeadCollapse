现在把方案落地——**写一个脱浏览器的 NPU 控制脚本**，并给出可执行的验证步骤：
[tool_call write_file] {"content":"#!/usr/bin/env python3\n\"\"\"\nnpu_console.py — 脱离浏览器控制 GitCode Notebook（昇腾 NPU 在线环境）\n\n## 为什么有这个脚本\n原工具包 `ascend-npu-console/scripts/notebook.js` 依赖 `mcp__node_repl__js` 宿主运行时\n（内部用 `agent.browsers` 找标签页）。在没有该运行时的环境里，`agent.browsers` 那一段不可用。\n\n## 关键判定（2026-09-11 实测）\n拆开看 notebook.js 有两层：\n  外层 = agent.browsers 找标签页（浏览器专属，不可移植）\n  内层 = REST 列终端 + WebSocket 执行命令（纯网络，与浏览器无关）\n\n实测鉴权层（探针 probe-ws-auth.py）：\n  - REST  `/online-action/<inst>/api/terminals`：假 instanceId 返回 502，不是 401/403\n  - WS    `/online-action/<inst>/terminals/websocket/<name>`：同上，502\n  => 服务器【先校验实例存在性，再校验 cookie】。实例不存在时根本没走到 cookie 校验。\n  => 只要拿到【有效的 instanceId + 终端名】，本脚本可能无需浏览器 cookie 即可直连。\n     ⚠ 这一步尚未用真实 instanceId 验证过（见 verify_route()）。\n\n## 用法\n  python npu_console.py --inst <instanceId> --term <terminalName> probe\n  python npu_console.py --inst <id> --term <name> run \"npu-smi info\"\n  python npu_console.py --inst <id> --term <name> run \"bash build.sh\"\n\n## 怎么拿 instanceId / terminalName\n两个来源：\n  A) 浏览器已打开 Notebook 时，从 iframe src 里读（见 --from-browser 说明）\n  B) 直接调 REST 列终端（若 A 不可用，且 REST 确实免 cookie）\n\"\"\"\n\nimport argparse\nimport json\nimport re\nimport socket\nimport ssl\nimport sys\nimport time\nimport base64\nimport os\n\nREST_HOST = \"aihub-run.gitcode.com\"\nWS_HOST = \"aihub-run.gitcode.com\"\n\n# ANSI 清洗（对齐 notebook.js 的 clean()）\nANSI_RE = re.compile(\n    r\"\\x1b\\[[0-9;]*[a-zA-Z]\"      # CSI 序列\n    r\"|\\x1b\\?2004[lh]\"            # bracketed paste 开关\n    r\"|\\x1b[()][AB0]\"             # 字符集\n    r\"|\\x1b\\[[0-9]*[ABCDHK]\"      # 光标\n    r\"|\\x1b\\[[0-9;]*K\"            # 清行\n)\n\n\ndef clean(text: str) -> str:\n    t = (text or \"\").replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n    return ANSI_RE.sub(\"\", t)\n\n\ndef list_terminals(inst: str, timeout=15):\n    \"\"\"REST 列终端。返回 (ok, payload)\"\"\"\n    import urllib.request\n    import urllib.error\n    url = f\"https://{REST_HOST}/online-action/{inst}/api/terminals\"\n    req = urllib.request.Request(url, headers={\"Accept\": \"application/json\"})\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            body = r.read().decode(\"utf-8\", \"replace\")\n            return True, {\"code\": r.status, \"data\": json.loads(body)}\n    except urllib.error.HTTPError as e:\n        return False, {\"code\": e.code, \"body\": e.read().decode(\"utf-8\", \"replace\")[:300]}\n    except Exception as e:\n        return False, {\"error\": f\"{type(e).__name__}: {e}\"}\n\n\n# ---------------- 最小 WebSocket 客户端（避免外部依赖） ----------------\n\nclass MiniWS:\n    \"\"\"够用的 WebSocket 客户端：只支持文本帧 + 分片接收。\"\"\"\n\n    def __init__(self, host, path, timeout=30, origin=\"https://gitcode.com\"):\n        self.host, self.path, self.timeout = host, path, timeout\n        self.sock = None\n        self.origin = origin\n\n    def connect(self):\n        key = base64.b64encode(os.urandom(16)).decode()\n        lines = [\n            f\"GET {self.path} HTTP/1.1\",\n            f\"Host: {self.host}\",\n            \"Upgrade: websocket\",\n            \"Connection: Upgrade\",\n            f\"Sec-WebSocket-Key: {key}\",\n            \"Sec-WebSocket-Version: 13\",\n            f\"Origin: {self.origin}\",\n        ]\n        raw = socket.create_connection((self.host, 443), timeout=self.timeout)\n        ctx = ssl.create_default_context()\n        self.sock = ctx.wrap_socket(raw, server_hostname=self.host)\n        self.sock.sendall((\"\\r\\n\".join(lines) + \"\\r\\n\\r\\n\").encode())\n        # 读握手响应\n        buf = b\"\"\n        self.sock.settimeout(self.timeout)\n        while b\"\\r\\n\\r\\n\" not in buf:\n            chunk = self.sock.recv(4096)\n            if not chunk:\n                break\n            buf += chunk\n        head = buf.split(b\"\\r\\n\\r\\n\", 1)[0].decode(\"utf-8\", \"replace\")\n        status = head.split(\"\\r\\n\")[0]\n        self.handshake_status = status\n        self._pending = buf.split(b\"\\r\\n\\r\\n\", 1)[1] if b\"\\r\\n\\r\\n\" in buf else b\"\"\n        return \"101\" in status, head\n\n    def send_text(self, text: str):\n        data = text.encode(\"utf-8\")\n        header = bytearray([0x81])                 # FIN + text\n        n = len(data)\n        if n < 126:\n            header.append(0x80 | n)\n        elif n < (1 << 16):\n            header.append(0x80 | 126)\n            header += n.to_bytes(2, \"big\")\n        else:\n            header.append(0x80 | 127)\n            header += n.to_bytes(8, \"big\")\n        mask = os.urandom(4)\n        header += mask\n        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(data))\n        self.sock.sendall(bytes(header) + masked)\n\n    def recv_text(self, deadline):\n        \"\"\"收一帧；返回 (text|None, closed)\"\"\"\n        while time.time() < deadline:\n            try:\n                self.sock.settimeout(max(0.2, deadline - time.time()))\n                b1 = self.sock.recv(1)\n                if not b1:\n                    return None, True\n                b2 = self.sock.recv(1)\n                opcode = b1[0] & 0x0F\n                length = b2[0] & 0x7F\n                if length == 126:\n                    length = int.from_bytes(self.sock.recv(2), \"big\")\n                elif length == 127:\n                    length = int.from_bytes(self.sock.recv(8), \"big\")\n                payload = b\"\"\n                while len(payload) < length:\n                    part = self.sock.recv(length - len(payload))\n                    if not part:\n                        break\n                    payload += part\n                if opcode == 0x8:\n                    return None, True\n                if opcode in (0x1, 0x2):\n                    return payload.decode(\"utf-8\", \"replace\"), False\n                if opcode == 0x9:       # ping -> pong\n                    self.sock.sendall(bytes([0x8A, 0x80]) + os.urandom(4))\n            except socket.timeout:\n                continue\n            except Exception:\n                return None, True\n        return None, False\n\n    def close(self):\n        try:\n            if self.sock:\n                self.sock.close()\n        except Exception:\n            pass\n\n\ndef run_one(inst, term, cmd, timeout_ms=30000, origin=\"https://gitcode.com\"):\n    \"\"\"在远端终端执行单条命令，用 marker 界定输出（对齐 notebook.js 协议）。\"\"\"\n    path = f\"/online-action/{inst}/terminals/websocket/{term}\"\n    ws = MiniWS(WS_HOST, path, timeout=max(10, timeout_ms / 1000 + 5), origin=origin)\n    ok, head = ws.connect()\n    if not ok:\n        return {\"ok\": False, \"handshake\": head}\n\n    marker = \"M\" + format(int(time.time() * 1000), \"x\") + os.urandom(3).hex()\n    line = f\"echo START:{marker}; {cmd}; echo DONE:{marker}\"\n\n    # bracketed-paste 包裹 + 回车（对齐 verified-route.md 2.3 的实测协议）\n    ws.send_text(json.dumps([\"stdin\", \"\\x1b[200~\" + line + \"\\x1b[201~\"]))\n    ws.send_text(json.dumps([\"stdin\", \"\\r\"]))\n\n    out = \"\"\n    deadline = time.time() + timeout_ms / 1000\n    timed_out = False\n    while True:\n        msg, closed = ws.recv_text(deadline)\n        if msg is not None:\n            try:\n                mm = json.loads(msg)\n                if isinstance(mm, list) and len(mm) > 1 and isinstance(mm[1], str):\n                    out += mm[1]\n            except Exception:\n                pass\n            if (\"\\nDONE:\" + marker) in out or (\"\\rDONE:\" + marker) in out:\n                break\n        if closed:\n            break\n        if time.time() >= deadline:\n            timed_out = True\n            break\n    ws.close()\n\n    text = clean(out)\n    start_tok, done_tok = \"START:\" + marker, \"DONE:\" + marker\n    # 取最后一个行首独立的 START（跳过滚动缓冲里的旧命令）\n    s, cursor = -1, 0\n    while True:\n        idx = text.find(start_tok, cursor)\n        if idx == -1:\n            break\n        if idx == 0 or text[idx - 1] == \"\\n\":\n            s = idx + len(start_tok)\n        cursor = idx + len(start_tok)\n    d = text.find(\"\\n\" + done_tok, max(0, s))\n    if d == -1:\n        d = text.find(done_tok, max(0, s))\n    body = text[s:d] if (s >= 0 and d > s) else \"\"\n    return {\"ok\": True, \"out\": body, \"timedOut\": timed_out, \"extractFail\": not (s >= 0 and d > s)}\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"脱浏览器控制 GitCode Notebook NPU 环境\")\n    ap.add_argument(\"--inst\", help=\"instance id（从 iframe src 提取）\")\n    ap.add_argument(\"--term\", help=\"终端名（REST 列出）\")\n    ap.add_argument(\"--origin\", default=\"https://gitcode.com\")\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n\n    p_list = sub.add_parser(\"list\", help=\"REST 列终端（验证免 cookie）\")\n    p_probe = sub.add_parser(\"probe\", help=\"探测 WS 能否直连（不依赖浏览器）\")\n    p_run = sub.add_parser(\"run\", help=\"执行一条命令\")\n    p_run.add_argument(\"command\")\n    p_run.add_argument(\"--timeout-ms\", type=int, default=30000)\n\n    args = ap.parse_args()\n\n    if args.cmd == \"list\":\n        if not args.inst:\n            print(\"需要 --inst\"); sys.exit(2)\n        ok, payload = list_terminals(args.inst)\n        print(json.dumps(payload, ensure_ascii=False, indent=2))\n        print(\"\\n=> 若返回 200 + 终端列表，说明 REST 免 cookie ✓\")\n        print(\"=> 若返回 502，说明 instanceId 无效或实例未启动\")\n        sys.exit(0 if ok else 1)\n\n    if args.cmd == \"probe\":\n        if not (args.inst and args.term):\n            print(\"需要 --inst 和 --term\"); sys.exit(2)\n        path = f\"/online-action/{args.inst}/terminals/websocket/{args.term}\"\n        ws = MiniWS(WS_HOST, path, timeout=20, origin=args.origin)\n        try:\n            ok, head = ws.connect()\n            print(\"握手状态:\", head.split(\"\\r\\n\")[0])\n            print(\"完整响应头:\")\n            for ln in head.split(\"\\r\\n\"):\n                if ln.strip():\n                    print(\"   \", ln)\n            print()\n            if ok:\n                print(\"=> 101 成功！**脱浏览器直连可行**（无需 cookie）\")\n                print(\"   下一步: python npu_console.py --inst ... --term ... run 'npu-smi info'\")\n            elif \"401\" in head or \"403\" in head:\n                print(\"=> 认证拒绝：确实依赖页面 cookie，必须走浏览器上下文\")\n            elif \"502\" in head or \"404\" in head:\n                print(\"=> 实例/终端不存在：id 或 term 有误，或实例未启动\")\n            else:\n                print(\"=> 未预期状态，请人工判读\")\n            ws.close()\n            sys.exit(0 if ok else 1)\n        except Exception as e:\n            print(f\"异常: {type(e).__name__}: {e}\")\n            sys.exit(1)\n\n    if args.cmd == \"run\":\n        if not (args.inst and args.term):\n            print(\"需要 --inst 和 --term\"); sys.exit(2)\n        r = run_one(args.inst, args.term, args.command,\n                    timeout_ms=args.timeout_ms, origin=args.origin)\n        if not r.get(\"ok\"):\n            print(\"连接失败:\", r.get(\"handshake\", r))\n            sys.exit(1)\n        print(r[\"out\"])\n        if r.get(\"timedOut\"):\n            print(\"[超时]\", file=sys.stderr)\n        if r.get(\"extractFail\"):\n            print(\"[警告] marker 未对齐，输出可能不完整\", file=sys.stderr)\n        sys.exit(0)\n\n\nif __name__ == \"__main__\":\n    main()\n","file_path":"d:\\Desktop\\OP-Learning\\Ascend\\ascend-npu-console\\scripts\\npu_console.py"}
