    TMPROOT="$PWD"
fi
export TMPDIR="$TMPROOT"
USER_PWD="$PWD"
if ! test -d "$USER_PWD"; then
    exit 1
fi
export USER_PWD
ARCHIVE_DIR=`dirname "$0"`
export ARCHIVE_DIR

