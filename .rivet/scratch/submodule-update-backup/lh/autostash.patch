+def print_candidate_sources(sources, problem_id: str = "") -> dict:
+    """Print and return an auditable source manifest without source contents."""
+    manifest = sources.manifest(problem_id)
+    print(f"候选目录: {manifest['candidate_dir']}")
+    print(f"代码目录: {manifest['code_dir']}")
+    for key in ("tiling_h", "tiling_key_h", "host_cpp", "kernel_cpp"):
+        relative = manifest["files"].get(key, "")
+        digest = manifest["sha256"].get(key, "")
+        if not relative:
+            print(f"{key}: <empty>")
+        else:
+            print(f"{key}: {relative} sha256={digest[:16]}")
+    return manifest
+
