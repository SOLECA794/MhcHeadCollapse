-    "        metrics.max_rel_error =\n",
-    "            std::max(metrics.max_rel_error, relativeError);\n",
-    "        if (absoluteError >\n",
-    "            absoluteTolerance +\n",
-    "                relativeTolerance * std::abs(expected)) {\n",
-    "            ++metrics.mismatch_count;\n",
-    "        }\n",
-    "    }\n",
-    "    return metrics;\n",
-    "}\n",
