-    "    }\n",
-    "\n",
-    "    LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;\n",
-    "    LocalTensor<float> tileLocal = ubAllocator.Alloc<float, kStaticMaxTileLen>();\n",
-    "    tileLocal.SetSize(kStaticMaxTileLen);"
