-    "        shards.emplace_back(\n",
-    "            gathered.begin() + static_cast<std::ptrdiff_t>(start),\n",
-    "            gathered.begin() + static_cast<std::ptrdiff_t>(start + shard_size));\n",
-    "    }\n",
