-    "            send_device,\n",
-    "            full_bytes,\n",
-    "            padded.data(),\n",
-    "            full_bytes,\n",
-    "            ACL_MEMCPY_HOST_TO_DEVICE));\n",
-    "\n",
-    "        const auto reduce_start = std::chrono::steady_clock::now();\n",
-    "        // 逐顶点求和后按 Rank 切分，每个 Rank 接收 shard_size 个 int64。\n",
