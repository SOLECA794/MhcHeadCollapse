-    "std::vector<CountVector> split_gathered_into_shards(\n",
-    "    const CountVector& gathered,\n",
-    "    std::size_t shard_size,\n",
-    "    int world_size) {\n",
-    "    // 为统一报告格式，把 AllGather 完整结果重新切成各 Rank 的规约分片。\n",
