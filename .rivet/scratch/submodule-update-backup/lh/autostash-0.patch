-    "                ++valid_rows;\n",
-    "            }\n",
-    "        }\n",
-    "    }\n",
-    "    return valid_rows;\n",
-    "}\n",
-    "\n",
-    "inline uint64_t estimated_input_copy_count(const Config& cfg,\n",
