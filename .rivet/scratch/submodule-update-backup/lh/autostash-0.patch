-    "                                  base, tileId * tileLen, tileLen);\n",
-    "        }\n",
-    "        for (uint32_t tileId = 0; tileId < numTilesPerRow; ++tileId) {\n",
-    "            const uint32_t base = rowBase + tileId * tileLen;\n",
-    "            PipelineDequeueAndScale(xQueue, gammaQueue, yQueue, invRms, tileLen);\n",
