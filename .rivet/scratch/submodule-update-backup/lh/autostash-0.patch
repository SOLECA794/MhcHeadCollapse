-    "        pairs.push_back({static_cast<int>(index), degree[index]});\n",
-    "    }\n",
-    "    std::sort(pairs.begin(), pairs.end(), [](const auto& lhs, const auto& rhs) {\n",
-    "        if (lhs.second != rhs.second) {\n",
